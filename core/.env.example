# ============================================================================
# 4mica core-service configuration
#
# Vars shown as <placeholder> are REQUIRED and must be set.
# All other vars show their built-in default and may be omitted.
# ============================================================================

# --- Secrets & database (required) ---
DATABASE_URL=<postgres_connection_url>
BLS_PRIVATE_KEY=<bls_private_key>
ETHEREUM_PRIVATE_KEY=<operator_private_key>
# Token signing key. Must be a 32+ byte random secret in production; a shorter or
# placeholder value hard-fails when SERVER_ENVIRONMENT=production.
AUTH_JWT_SECRET=<auth_jwt_secret>

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=info
# Deployment environment: `production` (default) or `development`. `production`
# enforces reorg-safe `finalized` confirmation, a strong AUTH_JWT_SECRET, an
# explicit https SIWE origin, and V1-only guarantees. `development` relaxes these
# for local/test use.
SERVER_ENVIRONMENT=production

# --- Ethereum / chain (RPC URLs and contract address are required) ---
ETHEREUM_CHAIN_ID=1
ETHEREUM_HTTP_RPC_URL=<ethereum_http_rpc_url>
ETHEREUM_WS_RPC_URL=<ethereum_ws_rpc_url>
# RPC URL advertised to SDK clients via getPublicParams. Empty = not advertised.
PUBLIC_ETHEREUM_HTTP_RPC_URL=
ETHEREUM_CONTRACT_ADDRESS=<core4mica_address>
# ClearingHouse address; the zero-address default disables clearing-house scanning.
ETHEREUM_CLEARING_HOUSE_ADDRESS=0x0000000000000000000000000000000000000000
# Max block span for a single eth_getLogs request.
ETHEREUM_MAX_LOG_BLOCK_RANGE=10000

# --- Scanning & scheduling (cron format: sec min hour dom mon dow) ---
# Settlement-cycle task scheduler cadence.
CRON_JOB_SETTINGS=0 */1 * * * *
# Event scanner cadence.
ETHEREUM_EVENT_SCANNER_CRON=*/5 * * * * *
# Blocks scanned back for payments on each run.
PAYMENT_SCAN_LOOKBACK_BLOCKS=5
# Legacy full-block payment scanner; keep off unless required (some RPCs return
# transaction shapes older clients cannot deserialize inside full blocks).
PAYMENT_LEGACY_SCAN_ENABLED=false
# Blocks scanned back on the first run when no cursor exists in the DB.
INITIAL_EVENT_SCAN_LOOKBACK_BLOCKS=25

# --- Confirmation policy ---
# `finalized` (required in production) reads the chain's finalized head.
# `depth`/`safe` treat recent (reorg-able) blocks as confirmed and require
# SERVER_ENVIRONMENT=development.
CONFIRMATION_MODE=finalized
# Only used when CONFIRMATION_MODE=depth.
NUMBER_OF_BLOCKS_TO_CONFIRM=20

# --- EIP-712 domain ---
EIP712_NAME=4mica
EIP712_VERSION=1

# --- Guarantee handling ---
# Preferred version advertised by /core/public-params. V2+ is validation-gated and
# disabled in production: with SERVER_ENVIRONMENT=production this must be 1, and any
# version >1 in the accepted set hard-fails startup. V2 is for development/test only.
GUARANTEE_REQUEST_VERSION=1
# Optional explicit allowlist (comma-separated). If empty: version N accepts 1..=N.
GUARANTEE_ACCEPTED_REQUEST_VERSIONS=
# Comma-separated registry addresses; required whenever a V2+ version is accepted.
TRUSTED_VALIDATION_REGISTRIES=
# Only 4MICA_VALIDATION_REQUEST_V2 is supported.
VALIDATION_HASH_CANONICALIZATION_VERSION=4MICA_VALIDATION_REQUEST_V2

# --- Settlement cycle (seconds) ---
# Must satisfy: cycle_to_finality + seizure_margin < on-chain withdrawalGracePeriod.
SETTLEMENT_CYCLE_SECS=86400
SETTLEMENT_RESOLUTION_CUTOFF_SECS=21600
SETTLEMENT_CLEARING_COMMIT_DELAY_SECS=900
SETTLEMENT_PAYMENT_SUBMISSION_WINDOW_SECS=7200
# Must be >= SETTLEMENT_PAYMENT_SUBMISSION_WINDOW_SECS.
SETTLEMENT_PAYMENT_FINALITY_WINDOW_SECS=14400
SETTLEMENT_SEIZURE_MARGIN_SECS=21600
# Max participants settled per on-chain batch transaction.
SETTLEMENT_DEFAULT_BATCH_SIZE=50

# --- Auth / SIWE ---
AUTH_NONCE_TTL_SECS=300
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=2592000
AUTH_JWT_ISSUER=4mica-core
AUTH_JWT_AUDIENCE=4mica
AUTH_SIWE_STATEMENT=Sign in to 4mica.
# SIWE sign-in origin bound into the login message. Required in production, where
# AUTH_SIWE_URI must be https; in development both fall back to the server bind host.
AUTH_SIWE_DOMAIN=<auth_siwe_domain>
AUTH_SIWE_URI=<auth_siwe_uri>

# --- Database ---
# Retries on serialization/lock conflicts before giving up.
DATABASE_CONFLICT_RETRIES=5

# --- Monitoring (cron format: sec min hour dom mon dow) ---
METRICS_UPKEEP_CRON=*/5 * * * * *
HEALTH_CHECK_CRON=*/30 * * * * *
